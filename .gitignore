# Tailwind build output, regenerated from src/css/main.css by `npm run
# build:css`. Not committed: a compiled artefact in the tree is one more thing
# that can be stale, and every path that serves it (dev server, e2e, deploy)
# builds it first.
static/css/output.css

# Claude Design bundle, regenerated from src/css/main.css by
# bin/export_design_system.py. Same reasoning: the script is the artefact
# worth versioning, not its output.
design-export/

